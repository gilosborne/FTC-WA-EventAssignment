{
  "name": "FTC WA Event Assignment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [5055, 8765],
  "portsAttributes": {
    "5055": {
      "label": "OSRM (optional routing)",
      "onAutoForward": "silent"
    },
    "8765": {
      "label": "Review map",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq osmium-tool && pip install -r Code/requirements.txt && bash Code/setup.sh",
  "waitFor": "postCreateCommand"
}
